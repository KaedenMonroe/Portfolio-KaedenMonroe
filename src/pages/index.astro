---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Avatar from "../components/Avatar.astro";
import InlineLink from "../components/InlineLink.astro";
import SectionWrapper from "../components/SectionWrapper.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getBio } from "../lib/content";
import { render } from "astro:content";

const bio = await getBio();
const { name, title, avatar, avatarAlt, email, resumeUrl, linkedinUrl } =
  bio.data;
const { Content } = await render(bio);

// Placeholder entries: the projects listing (scope item 6) builds the real
// grid from getVisibleProjects(); this page only owns the bio section.
const projects = [
  {
    title: "Project title",
    subtitle: "Project subtitle",
    tags: ["Tag"],
  },
  {
    title: "Project title",
    subtitle: "Project subtitle",
    tags: ["Tag"],
  },
  {
    title: "Project title",
    subtitle: "Project subtitle",
    tags: ["Tag"],
  },
];
---

<Layout title={name} description={`${title}. Bio, research, and project work.`}>
  <div class="mx-auto max-w-4xl px-6">
    <Nav name={name} resumeHref={resumeUrl} />

    <SectionWrapper id="about" aria-label="About">
      <div class="flex items-center gap-4">
        <Avatar src={avatar} alt={avatarAlt} />
        <div>
          <p class="text-xl font-medium">{name}</p>
          <p class="text-base text-text-secondary">{title}</p>
        </div>
      </div>
      <div class="mt-8 flex max-w-[650px] flex-col gap-4 text-base">
        <Content />
      </div>
      <ul class="mt-6 flex items-center gap-3 text-base sm:gap-6">
        <li><InlineLink href={`mailto:${email}`}>Email</InlineLink></li>
        <li>
          <InlineLink href={linkedinUrl} external>LinkedIn</InlineLink>
        </li>
      </ul>
    </SectionWrapper>

    <SectionWrapper id="projects" spaced aria-label="Projects">
      <ul class="flex flex-wrap gap-8">
        {
          projects.map((project) => (
            <li>
              <ProjectCard
                image="/placeholders/project.svg"
                alt={`${project.title} preview`}
                title={project.title}
                subtitle={project.subtitle}
                tags={project.tags}
              />
            </li>
          ))
        }
      </ul>
    </SectionWrapper>
  </div>
</Layout>
