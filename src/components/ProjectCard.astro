---
import { Image } from "astro:assets";
import Tag from "./Tag.astro";

interface Props {
  image: ImageMetadata | string;
  alt: string;
  title: string;
  subtitle: string;
  tags?: string[];
  class?: string;
}

const {
  image,
  alt,
  title,
  subtitle,
  tags = [],
  class: className,
} = Astro.props;
const classes = ["flex w-72 shrink-0 flex-col gap-3", className]
  .filter(Boolean)
  .join(" ");
---

<article class={classes}>
  {
    typeof image === "string" ? (
      <img
        src={image}
        alt={alt}
        class="aspect-[3/2] w-full rounded-md object-cover"
      />
    ) : (
      <Image
        src={image}
        alt={alt}
        class="aspect-[3/2] w-full rounded-md object-cover"
      />
    )
  }
  <div class="flex flex-col gap-1">
    <h3 class="text-base font-medium">{title}</h3>
    <p class="text-sm text-text-secondary">{subtitle}</p>
    {
      tags.length > 0 && (
        <ul class="mt-1 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li>
              <Tag>{tag}</Tag>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
