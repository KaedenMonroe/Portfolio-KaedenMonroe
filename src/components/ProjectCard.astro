---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

type GalleryItem = CollectionEntry<"projects">["data"]["gallery"][number];

interface Props {
  cover: ImageMetadata | string;
  coverAlt: string;
  gallery?: GalleryItem[];
  class?: string;
}

const { cover, coverAlt, gallery = [], class: className } = Astro.props;

const images: { src: ImageMetadata | string; alt: string }[] = [
  { src: cover, alt: coverAlt },
  ...gallery
    .filter(
      (item): item is Extract<GalleryItem, { type: "image" }> =>
        item.type === "image",
    )
    .map((item) => ({ src: item.src, alt: item.alt })),
];

const classes = [
  "relative aspect-[3/2] w-[min(18rem,78vw)] shrink-0 overflow-hidden rounded-md bg-bg-secondary",
  className,
]
  .filter(Boolean)
  .join(" ");
---

<div class={classes} data-gallery>
  {
    images.map((img, index) => {
      const imgClasses = [
        "absolute inset-0 h-full w-full object-cover transition-opacity duration-(--duration-fade) ease-out motion-reduce:duration-0",
        index === 0 ? "opacity-100" : "opacity-0",
      ].join(" ");
      return typeof img.src === "string" ? (
        <img
          src={img.src}
          alt={img.alt}
          data-gallery-image
          data-index={index}
          aria-hidden={index === 0 ? undefined : "true"}
          loading={index === 0 ? "eager" : "lazy"}
          class={imgClasses}
        />
      ) : (
        <Image
          src={img.src}
          alt={img.alt}
          data-gallery-image
          data-index={index}
          aria-hidden={index === 0 ? undefined : "true"}
          loading={index === 0 ? "eager" : "lazy"}
          class={imgClasses}
        />
      );
    })
  }
</div>
